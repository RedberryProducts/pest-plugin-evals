{
    "name": "redberry/pest-plugin-evals",
    "description": "A Pest plugin for evaluating LLM Outputs",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "evaluation",
        "llm",
        "ai",
        "plugin"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/ai": "^0.2.1",
        "pestphp/pest": "^4.3.1",
        "pestphp/pest-plugin": "^4.0.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Redberry\\Evals\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.9",
        "pestphp/pest-dev-tools": "^4.0.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "refacto": "rector",
        "lint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --testsuite=default --colors=always",
        "test:integration": "pest --testsuite=integration --colors=always",
        "test:usage": "pest --testsuite=usage-tests --colors=always",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Redberry\\Evals\\EvalServiceProvider"
            ]
        }
    }
}
